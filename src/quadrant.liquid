<div class="layout layout--col layout--top layout--left gap--small {{ font_cls }}">
{% if cal == blank %}
  {% render "pc_empty", text: t_setup %}
{% else %}

  {% render "pc_header", month: month_label, year: year, aside: "", cls: "title--small lg:title" %}

  {% render "pc_grid", days: days, count: day_count, today: today, accent: accent, labels: wd_labels, narrow: true, cell_cls: "pc-size--md", num_cls: "value--xsmall portrait:value--xxsmall lg:value--small lg:portrait:value--xsmall" %}

  <div class="divider mt--2 mb--2 lg:mt--4 lg:mb--4"></div>
  
  {% comment %} With 1 week there's room for the next appointment {% endcomment %}
  {% if day_count <= 7 %}
    {% render "pc_agenda", events: cal.events, mode: mode, agenda: agenda, today: today, now_hm: now_hm, today_count: today_count, fmt: time_format, accent: accent, months_short: months_short, t_today: t_today, t_all_day: t_all_day, t_empty_today: t_empty_today, t_empty: t_empty, show_desc: false, cols_cls: "grid--cols-1", max_days: 1, max_items: 1, flow: false, clamp: 1, head_cls: "title--small lg:title--base lg:text--bold", title_cls: "lg:title" %}
  {% endif %}

{% endif %}
</div>
