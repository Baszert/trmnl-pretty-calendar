<div class="layout layout--col layout--top gap--medium {{ font_cls }}">
{% if cal == blank %}
  {% render "pc_empty", text: t_setup %}
{% else %}

  {% render "pc_header", month: month_label, year: year, aside: "", cls: "title--large" %}

  {% render "pc_grid", days: days, count: day_count, today: today, accent: accent, labels: wd_labels, days_short: days_short, wide: true, wide_count: wide_count, cell_cls: "pc-size--xl", num_cls: "value--small lg:value" %}

  <div class="divider"></div>

  {% render "pc_agenda", events: cal.events, mode: mode, agenda: agenda, today: today, now_hm: now_hm, today_count: today_count, fmt: time_format, accent: accent, months_short: months_short, t_today: t_today, t_all_day: t_all_day, t_empty_today: t_empty_today, t_empty: t_empty, show_desc: show_desc, cols_cls: "grid--cols-3 portrait:grid--cols-1", max_days: 3, max_items: 6, flow: true, clamp: 2, head_cls: "title--small lg:title", title_cls: "lg:title" %}

{% endif %}
</div>
