<div class="layout layout--row portrait:layout--col layout--top gap--large {{ font_cls }}">
{% if cal == blank %}
  {% render "pc_empty", text: t_setup %}
{% else %}

  <div class="pc-side flex flex--col gap--small">
    {% render "pc_header", month: month_label, year: year, aside: "", cls: "" %}
    {% render "pc_grid", days: days, count: day_count, today: today, accent: accent, labels: wd_labels, days_short: days_short, wide: false, cell_cls: "pc-size--md", num_cls: "value--xsmall lg:value--small" %}
  </div>

  <div class="pc-vrule bg--gray-60 1bit:bg--black"></div>

  {% render "pc_agenda", events: cal.events, mode: mode, agenda: agenda, today: today, now_hm: now_hm, today_count: today_count, fmt: time_format, accent: accent, months_short: months_short, t_today: t_today, t_all_day: t_all_day, t_empty_today: t_empty_today, t_empty: t_empty, show_desc: false, cols_cls: "grid--cols-1", max_days: 1, max_items: 3, flow: false, clamp: 1, head_cls: "title--small", title_cls: "" %}

{% endif %}
</div>
