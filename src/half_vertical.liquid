<div class="layout layout--col layout--top layout--left gap--small {{ font_cls }}">
{% if cal == blank %}
  {% render "pc_empty", text: t_setup %}
{% else %}

  {% render "pc_header", month: month_label, year: year, aside: "", cls: "portrait:title--small lg:title--large lg:portrait:title" %}

  {% render "pc_grid", days: days, count: day_count, today: today, accent: accent, labels: wd_labels, narrow: true, cell_cls: "pc-size--md", num_cls: "value--xsmall portrait:value--xxsmall lg:value lg:portrait:value--small" %}

  <div class="divider mt--3 mb--3"></div>

  {% render "pc_agenda", events: cal.events, mode: mode, agenda: agenda, today: today, now_hm: now_hm, today_count: today_count, fmt: time_format, accent: accent, months_short: months_short, t_today: t_today, t_all_day: t_all_day, t_empty_today: t_empty_today, t_empty: t_empty, show_desc: show_desc, cols_cls: "grid--cols-1", max_days: 3, max_items: 4, flow: false, clamp: 1, head_cls: "title--small lg:title", title_cls: "lg:title" %}

{% endif %}
</div>
