{% assign accent = cfg.accent_color | default: "red" %}
{% assign font = cfg.font | default: "framework" %}
{% assign show_desc = true %}
{% if cfg.show_descriptions == "no" %}{% assign show_desc = false %}{% endif %}
{% assign time_format = cal.time_format | default: "24h" %}
{% assign first_day = cal.first_day | default: 1 | plus: 0 %}

{% assign font_cls = "" %}
{% if font == "google" %}{% assign font_cls = "pc--google" %}{% endif %}

{% assign lang = cfg.language | default: "auto" %}
{% if lang == "auto" %}
  {% assign lang = trmnl.user.locale | default: "en" | slice: 0, 2 | downcase %}
{% endif %}
{% if lang == "no" or lang == "nn" %}{% assign lang = "nb" %}{% endif %}


